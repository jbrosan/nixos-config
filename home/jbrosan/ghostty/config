# Portable Ghostty configuration

# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-feature = +calt
font-feature = +liga

# Dynamic Vader glass theme
theme = dankcolors
background-opacity = 0.70
background-blur-radius = 32

# Window
window-decoration = true
window-theme = ghostty
window-padding-x = 12
window-padding-y = 12
confirm-close-surface = false
resize-overlay = never
gtk-toolbar-style = flat
gtk-titlebar = false
gtk-single-instance = true

# Cursor and split appearance
cursor-style = block
cursor-style-blink = true
unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f

# Terminal behavior
scrollback-limit = 100000
mouse-hide-while-typing = true
mouse-scroll-multiplier = 0.95
copy-on-select = false
app-notifications = no-clipboard-copy,no-config-reload

# Shell integration, including remote SSH environment support
shell-integration = detect
shell-integration-features = sudo,title,no-cursor,ssh-env

# Daily-use bindings
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = shift+enter=text:\n
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Animated cursor shader
custom-shader-animation = always
custom-shader = shaders/cursor_frozen.glsl
