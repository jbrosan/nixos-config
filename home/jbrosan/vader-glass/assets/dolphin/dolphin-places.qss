/* Mustafar Vader Glass: Dolphin Places panel only */
KFilePlacesView,
KFilePlacesView QAbstractScrollArea,
KFilePlacesView QWidget,
KFilePlacesView::viewport {
    background-color: #202226;
    color: #E6E7EA;
    selection-background-color: #8F101A;
    selection-color: #FFFFFF;
}
KFilePlacesView QProgressBar {
    background-color: #303238;
    color: #E6E7EA;
    border: 0;
}
KFilePlacesView QProgressBar::chunk {
    background-color: #C1121F;
}
