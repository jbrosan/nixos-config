[%General]
alt_mnemonic=true
animate_states=false
attach_active_tab=true
author=Tsu Jan
blurring=false
button_icon_size=16
center_toolbar_handle=true
check_size=14
click_behavior=0
combo_as_lineedit=true
combo_focus_rect=true
combo_menu=true
comment=A minimalistic dark theme inspired by the Arc GTK theme
composite=true
fill_rubberband=false
group_toolbar_buttons=false
groupbox_top_label=true
hide_combo_checkboxes=true
inline_spin_indicators=false
joined_inactive_tabs=false
large_icon_size=32
layout_margin=9
layout_spacing=6
left_tabs=true
menu_separator_height=6
menu_shadow_depth=5
menubar_mouse_tracking=true
merge_menubar_with_toolbar=true
mirror_doc_tabs=true
popup_blurring=false
progressbar_thickness=3font
scroll_arrows=false
scroll_min_extent=60
scroll_width=9
scrollbar_in_view=true
slider_handle_length=18
slider_handle_width=18
slider_width=6
small_icon_size=16
spin_button_width=32
splitter_width=4
spread_progressbar=true
submenu_overlap=3
textless_progressbar=false
toolbar_icon_size=22
toolbar_interior_spacing=3
toolbar_item_spacing=1
toolbutton_style=1
tooltip_delay=-1
tooltip_shadow_depth=6
transient_groove=true
transient_scrollbar=true
translucent_windows=false
tree_branch_line=true
vertical_spin_indicators=false
x11drag=menubar_and_primary_toolbar

[CheckBox]
frame=false
inherits=PanelButtonCommand
interior.element=checkbox
text.focus.color=white
text.normal.color=#ffffffc8

[ComboBox]
frame.element=combo
indicator.element=carrow
inherits=PanelButtonCommand
interior.element=combo
text.press.color=#ffffffc8

[Dock]
frame.bottom=1
frame.element=dock
frame.left=1
frame.right=1
frame.top=1
inherits=PanelButtonCommand
interior.element=dock
text.normal.color=#ffffffc8

[DockTitle]
frame=false
inherits=PanelButtonCommand
interior=false
text.bold=true
text.focus.color=white
text.normal.color=#ffffff96

[DropDownButton]
indicator.element=arrow-down
inherits=PanelButtonCommand

[Focus]
frame=true
frame.bottom=1
frame.element=focus
frame.left=1
frame.patternsize=20
frame.right=1
frame.top=1
inherits=PanelButtonCommand

[General]
menu_shadow_depth=7
tooltip_shadow_depth=6
translucent_menu=false

[GeneralColors]
alt.base.color=#3c434f
base.color=#404552
button.color=#414654
button.text.color=#ffffffc8
dark.color=black
disabled.text.color=#ffffff73
highlight.color=#C1121F
highlight.text.color=white
inactive.highlight.color=#C1121F
light.color=#5f677f
link.color=#E12A35
link.visited.color=#C75B64
mid.color=#191919
mid.light.color=#313131
progress.indicator.text.color=white
text.color=#ffffffc8
tooltip.text.color=#eefcff
window.color=#383c4a
window.text.color=#ffffffc8

[GenericFrame]
frame=true
frame.bottom=3
frame.element=common
frame.left=3
frame.right=3
frame.top=3
inherits=PanelButtonCommand
interior=false
interior.element=common

[GroupBox]
frame=false
frame.expansion=0
inherits=GenericFrame
text.bold=true
text.focus.color=white
text.margin=0
text.normal.color=#ffffff96
text.shadow=0

[Hacks]
blur_translucent=true
disabled_icon_opacity=100
force_size_grip=true
iconless_menu=false
iconless_pushbutton=true
lxqtmainmenu_iconsize=22
normal_default_pushbutton=true
respect_darkness=true
